# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
steward
gpctl

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Go workspace file
go.work

# Dependency directories
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Kubernetes
kubeconfig
*.kubeconfig

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# .terraform.lock.hcl is NOT ignored: commit it so provider versions and
# checksums are pinned (HashiCorp guidance).
terraform.tfvars
*.auto.tfvars

# Secrets
*.pem
*.key
secrets.yaml
secrets/

# Build
dist/
build/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Local environment overrides. The operator reads only flags and environment
# variables such as STEWARD_PROVIDER; config.example.yaml is an unused sketch.
.env
